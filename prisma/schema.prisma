generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Resource {
  id              String         @id @default(cuid())
  fullName        String
  email           String         @unique
  password        String?
  role            String         @default("User") // Admin, User, Report, Moderator
  phoneNumber     String?
  telephoneNumber String?
  photo           String?
  team            Team?          @relation(fields: [teamId], references: [id])
  teamId          String?
  tasks           Task[]
  vendor          Vendor?        @relation(fields: [vendorId], references: [id])
  vendorId        String?
  exercise        Exercise?      @relation(fields: [exerciseId], references: [id])
  exerciseId      String?
  ownedExercises  Exercise[]     @relation("ExerciseOwner")
  availabilities  Availability[]
}

model Vendor {
  id         String     @id @default(cuid())
  name       String
  type       String     // Internal, External
  email      String?
  phone      String?
  photo      String?
  teams      Team[]
  resources  Resource[]
  exercise   Exercise?  @relation(fields: [exerciseId], references: [id])
  exerciseId String?
}

model Team {
  id          String     @id @default(cuid())
  name        String
  description String?
  photo       String?
  vendor      Vendor?    @relation(fields: [vendorId], references: [id])
  vendorId    String?
  resources   Resource[]
  tasks       Task[]
  exercise    Exercise?  @relation(fields: [exerciseId], references: [id])
  exerciseId  String?
}

model Exercise {
  id             String         @id @default(cuid())
  name           String
  startDate      DateTime?
  endDate        DateTime?
  status         String         @default("Planned") // Planned, In-Progress, On-Hold, Completed, Cancelled
  photo          String?
  notes          String?
  mock3Required  Boolean        @default(false)
  owners         Resource[]     @relation("ExerciseOwner")
  resources      Resource[]
  vendors        Vendor[]
  teams          Team[]
  phases         Phase[]
  stages         Stage[]
  tasks          Task[]
  availabilities Availability[]
}

model Phase {
  id             String         @id @default(cuid())
  name           String         // Mock 1, Mock 2, Mock 3, Prod
  order          Int
  exercise       Exercise       @relation(fields: [exerciseId], references: [id])
  exerciseId     String
  events         Event[]
  availabilities Availability[]
}

model Event {
  id        String   @id @default(cuid())
  name      String   // Failover, Failback
  startDate DateTime?
  endDate   DateTime?
  phase     Phase    @relation(fields: [phaseId], references: [id])
  phaseId   String
  stages    Stage[]
}

model Stage {
  id        String    @id @default(cuid())
  name      String    // Pre-Failover, Failover, Post-Failover, Failover-Rollback, Pre-Failback, Failback, Post-Failback, Failback-Rollback
  startDate DateTime?
  endDate   DateTime?
  exercise  Exercise  @relation(fields: [exerciseId], references: [id])
  exerciseId String
  event     Event?    @relation(fields: [eventId], references: [id])
  eventId   String?
  notes     String?
  tasks     Task[]
}

model Task {
  id                 String    @id @default(cuid())
  taskId             String
  workflow           String    @default("Sequential") // Sequential, Parallel
  resourceAllocation String    @default("Single") // Single, Multiple
  status             String    @default("Not-Started") // Not-Started, In-Progress, Completed, Failed
  startDate          DateTime?
  endDate            DateTime?
  estimatedTime      Int?      // In minutes
  actualDuration     Int?
  varianceDuration   Int?
  evidence           String?
  notes              String?
  stage              Stage     @relation(fields: [stageId], references: [id])
  stageId            String
  resources          Resource[]
  team               Team?     @relation(fields: [teamId], references: [id])
  teamId             String?
  exercise           Exercise  @relation(fields: [exerciseId], references: [id])
  exerciseId         String
}

model Availability {
  id         String   @id @default(cuid())
  resource   Resource @relation(fields: [resourceId], references: [id])
  resourceId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId String
  phase      Phase    @relation(fields: [phaseId], references: [id])
  phaseId    String
  available  Boolean  @default(false)
  notes      String?

  @@unique([resourceId, phaseId])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  schedules EmailSchedule[]
}

model EmailList {
  id        String   @id @default(cuid())
  name      String
  emails    String
  createdAt DateTime @default(now())
  schedules EmailSchedule[]
}

model EmailSchedule {
  id            String   @id @default(cuid())
  template      EmailTemplate @relation(fields: [templateId], references: [id])
  templateId    String
  lists         EmailList[]
  scheduledAt   DateTime
  status        String   @default("Pending") // Pending, Sent, Failed
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}
